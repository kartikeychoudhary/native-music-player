{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"], "@protocol/*": ["../shared/protocol/*"] }
  },
  "include": ["src", "test", "e2e", "build-tools", "../shared/protocol", "*.config.ts"]
}
